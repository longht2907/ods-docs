{
  "name": "ods-docs",
  "version": "0.0.28",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "guard": "node scripts/guard.mjs",
    "check:links": "node harness/linters/broken-links.mjs",
    "check:scope": "node harness/linters/scope-check.mjs",
    "check:env": "node harness/linters/env-guard.mjs",
    "test:routes": "node harness/tests/routes.test.mjs",
    "verify:code": "npm run types:check && npm run check:env && npm run check:links && npm run guard",
    "verify": "npm run verify:code && npm run build",
    "verify:task": "npm run verify:code && npm run check:scope && npm run build && npm run test:routes"
  },
  "dependencies": {
    "fumadocs-core": "16.15.10",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.10",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
